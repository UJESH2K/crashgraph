# Build context: keep it to the source. The trained graph and the flight recordings are large
# and belong to a particular run, not to the image. The 3D models are included — they are
# licensed for redistribution, and without them a deployment falls back to plain shapes.
.git
.venv
__pycache__
**/__pycache__
data
web-next/node_modules
web-next/.next
web-next/out
web-next/tsconfig.tsbuildinfo
web/assets/*.glb
*.db
*.rdb
.env
